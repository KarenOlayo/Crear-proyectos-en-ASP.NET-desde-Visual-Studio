@model IEnumerable<SistemaBiblioteca.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">📚 Lista de Libros</h2>
    <a asp-action="Create" class="btn btn-dark">
        + Nuevo Libro
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center">
        No hay libros registrados aún. ¡Agrega el primero!
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>ISBN</th>
                        <th>Autor</th>
                        <th>Área</th>
                        <th>Género</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted small">@item.Id</td>
                            <td class="fw-semibold">@item.Titulo</td>
                            <td><code>@item.ISBN</code></td>
                            <td>@item.Autor</td>
                            <td>@(item.Area ?? "-")</td>
                            <td>@(item.Genero ?? "-")</td>
                            <td>
                                @if (item.Estado == "Disponible")
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else if (item.Estado == "Prestado")
                                {
                                    <span class="badge bg-warning text-dark">Prestado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Estado</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}